{
    "actorSpecification": 1,
    "name": "uk-sponsored-tech-jobs",
    "title": "UK Sponsored Tech Jobs Pipeline",
    "description": "Daily ranked feed of UK AI/ML/SDE jobs at A-rated Skilled Worker visa sponsors. Cross-references the Home Office sponsor register against live LinkedIn job postings.",
    "version": "0.1",
    "buildTag": "latest",
    "meta": {
        "templateId": "python-start"
    },
    "input": "./input_schema.json",
    "dockerfile": "../Dockerfile",
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Ranked sponsored jobs",
            "views": {
                "overview": {
                    "title": "Ranked feed",
                    "transformation": {
                        "fields": [
                            "fit_score", "title", "company_sponsor",
                            "location", "posted_at", "url"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "fit_score": { "label": "Score", "format": "number" },
                            "title":     { "label": "Role" },
                            "company_sponsor": { "label": "Company" },
                            "location":  { "label": "Location" },
                            "posted_at": { "label": "Posted" },
                            "url":       { "label": "Apply", "format": "link" }
                        }
                    }
                }
            }
        }
    }
}
